#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
SERVICE="sysguard-dashboard"
DASHBOARD_URL="http://127.0.0.1:8765"
VENV="${HOME}/.venvs/sysguard-dashboard"
ENV_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sysguard-dashboard"
ENV_FILE="$ENV_DIR/sysguard-dashboard.env"
UNIT_FILE="/etc/systemd/system/${SERVICE}.service"

usage() {
    cat <<'HELP'
SysGuard - Linux monitoring and automation

Usage:
  sysguard help
  sysguard version

  sysguard monitor
  sysguard backup
  sysguard report

  sysguard agent setup
  sysguard agent status
  sysguard agent start
  sysguard agent stop
  sysguard agent restart
  sysguard agent pair

  sysguard dashboard open
  sysguard dashboard url

Examples:
  sysguard agent setup
  sysguard agent pair
  sysguard dashboard open
HELP
}

require_systemd() {
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "ERROR: systemctl is not available on this system."
        exit 1
    fi

    if ! systemctl is-system-running >/dev/null 2>&1 &&
       [[ "$(systemctl is-system-running 2>/dev/null || true)" != "degraded" ]]; then
        echo "WARNING: systemd may not be fully operational."
    fi
}

agent_setup() {
    require_systemd

    echo "========== SYSGUARD AGENT SETUP =========="
    echo "Project: $PROJECT_DIR"
    echo "Linux user: $USER"

    if [[ ! -f "$PROJECT_DIR/dashboard/agent/app.py" ]]; then
        echo "ERROR: Dashboard backend not found."
        exit 1
    fi

    if [[ ! -f "$PROJECT_DIR/dashboard/requirements.txt" ]]; then
        echo "ERROR: Dashboard requirements file not found."
        exit 1
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        echo "ERROR: Install Python 3 first."
        exit 1
    fi

    mkdir -p "$HOME/.venvs" "$ENV_DIR"
    chmod 700 "$ENV_DIR"

    if [[ ! -x "$VENV/bin/python" ]]; then
        python3 -m venv "$VENV"
    fi

    "$VENV/bin/python" -m pip install --upgrade pip
    "$VENV/bin/python" -m pip install -r "$PROJECT_DIR/dashboard/requirements.txt"

    touch "$ENV_FILE"
    chmod 600 "$ENV_FILE"

    if ! grep -q '^SYSGUARD_API_TOKEN=' "$ENV_FILE"; then
        printf 'SYSGUARD_API_TOKEN=%s\n' \
            "$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')" \
            >> "$ENV_FILE"
    fi

    if ! grep -q '^SYSGUARD_SESSION_SECRET=' "$ENV_FILE"; then
        printf 'SYSGUARD_SESSION_SECRET=%s\n' \
            "$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')" \
            >> "$ENV_FILE"
    fi

    set_env_value() {
        local key="$1"
        local value="$2"
        if grep -q "^${key}=" "$ENV_FILE"; then
            sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
        else
            printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
        fi
    }

    set_env_value SYSGUARD_HOME "$PROJECT_DIR"
    set_env_value SYSGUARD_BIND_HOST "127.0.0.1"
    set_env_value SYSGUARD_PORT "8765"

    chmod 600 "$ENV_FILE"

    UNIT_TMP="$(mktemp)"
    cat > "$UNIT_TMP" <<UNIT
[Unit]
Description=SysGuard Dashboard API
After=network.target

[Service]
Type=simple
User=$USER
WorkingDirectory=$PROJECT_DIR/dashboard/agent
EnvironmentFile=$ENV_FILE
ExecStart=$VENV/bin/gunicorn --workers 2 --bind 127.0.0.1:8765 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=$PROJECT_DIR/config $PROJECT_DIR/logs $PROJECT_DIR/backups $PROJECT_DIR/reports

[Install]
WantedBy=multi-user.target
UNIT

    echo
    echo "Installing systemd service. Administrator permission is required."
    sudo install -m 0644 "$UNIT_TMP" "$UNIT_FILE"
    rm -f "$UNIT_TMP"

    sudo systemctl daemon-reload
    sudo systemctl enable "$SERVICE"
    sudo systemctl restart "$SERVICE"

    echo
    if sudo systemctl is-active --quiet "$SERVICE"; then
        echo "SysGuard agent setup completed."
        echo "Dashboard: $DASHBOARD_URL"
        echo "Environment file: $ENV_FILE"
        echo "Secrets are stored locally and are not displayed."
    else
        echo "ERROR: The agent did not start."
        sudo systemctl status "$SERVICE" --no-pager
        exit 1
    fi
}

agent_status() {
    require_systemd
    sudo systemctl status "$SERVICE" --no-pager
}

agent_start() {
    require_systemd
    sudo systemctl start "$SERVICE"
    sudo systemctl is-active "$SERVICE"
}

agent_stop() {
    require_systemd
    sudo systemctl stop "$SERVICE"
    echo "SysGuard agent stopped."
}

agent_restart() {
    require_systemd
    sudo systemctl restart "$SERVICE"
    sudo systemctl is-active "$SERVICE"
}

agent_pair() {
    if [[ ! -x "$PROJECT_DIR/scripts/agent-pair" ]]; then
        chmod +x "$PROJECT_DIR/scripts/agent-pair"
    fi
    "$PROJECT_DIR/scripts/agent-pair"
}

dashboard_open() {
    echo "Opening $DASHBOARD_URL"

    if command -v cmd.exe >/dev/null 2>&1; then
        cmd.exe /c start "" "$DASHBOARD_URL" >/dev/null 2>&1 || true
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$DASHBOARD_URL" >/dev/null 2>&1 &
    else
        echo "Open this address in your browser: $DASHBOARD_URL"
    fi
}

case "${1:-help}" in
    help|-h|--help)
        usage
        ;;
    version|-v|--version)
        echo "SysGuard ${SYSGUARD_VERSION:-1.0}"
        ;;
    monitor)
        exec bash "$PROJECT_DIR/scripts/sysguard.sh"
        ;;
    backup)
        exec bash "$PROJECT_DIR/scripts/backup.sh"
        ;;
    report)
        exec bash "$PROJECT_DIR/scripts/health-report.sh"
        ;;
    agent)
        case "${2:-help}" in
            setup) agent_setup ;;
            status) agent_status ;;
            start) agent_start ;;
            stop) agent_stop ;;
            restart) agent_restart ;;
            pair) agent_pair ;;
            *)
                echo "Usage: sysguard agent {setup|status|start|stop|restart|pair}"
                exit 1
                ;;
        esac
        ;;
    dashboard)
        case "${2:-help}" in
            open) dashboard_open ;;
            url) echo "$DASHBOARD_URL" ;;
            *)
                echo "Usage: sysguard dashboard {open|url}"
                exit 1
                ;;
        esac
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
